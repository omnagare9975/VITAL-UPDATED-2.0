# ── Copy this file to .env and fill in real values ────────────────────────────
#    cp .env.docker .env

# MongoDB credentials (Docker internal — change in production)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=vitalpass

# JWT secret — use a long random string
JWT_SECRET=change_me_to_a_long_random_secret

# Groq API key — get free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your S3 website URL (for CORS) — set after S3 deploy
# Example: http://vital-app.s3-website.ap-south-1.amazonaws.com
CLIENT_URL=http://localhost:3000
