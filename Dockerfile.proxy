# ── VITAL PDF Proxy ───────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

# Use npm install (not npm ci) — more forgiving with lock file drift
RUN npm install --omit=dev

COPY proxyserver.cjs .

EXPOSE 3003

CMD ["node", "proxyserver.cjs"]
